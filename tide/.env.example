# ============================================================
# Tide — Environment Variables
# ============================================================

# REQUIRED: Your deployed Tide package ID on Sui
TIDE_PACKAGE_ID=0xd6a19fc6db4c7ad58e5b453b2b208053caab7c3681b473f2e6261bd79dd964f6

# Network: testnet | devnet | mainnet
NETWORK=testnet

# Sui RPC endpoint
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Postgres
POSTGRES_PASSWORD=tide_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://tide:tide_dev_password@localhost:5432/tide_recall

# Indexer tuning
POLL_INTERVAL_MS=2000
BATCH_SIZE=50
MODULE_NAME=memory
