# ============================================================
# Tide Recall — Environment Variables
# ============================================================

# REQUIRED: Your deployed Tide package ID on Sui
TIDE_PACKAGE_ID=0x61f59d91f6ac0c1a321a2682d7d70cab4bc0425ed1d8b417d2494f0bbc0d6be0

# Network: testnet | devnet | mainnet
NETWORK=testnet

# Sui RPC endpoint
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Postgres
POSTGRES_PASSWORD=tide_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://tide:tide_dev_password@localhost:5432/tide_recall

# Indexer tuning
POLL_INTERVAL_MS=2000
BATCH_SIZE=50
MODULE_NAME=memory
