# ============================================================
# Manta Recall — Environment Variables
# ============================================================

# REQUIRED: Your deployed Manta package ID on Sui
MANTA_PACKAGE_ID=0x61f59d91f6ac0c1a321a2682d7d70cab4bc0425ed1d8b417d2494f0bbc0d6be0

# Network: testnet | devnet | mainnet
NETWORK=testnet

# Sui RPC endpoint
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Postgres
POSTGRES_PASSWORD=manta_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://manta:manta_dev_password@localhost:5432/manta_recall

# Indexer tuning
POLL_INTERVAL_MS=2000
BATCH_SIZE=50
MODULE_NAME=memory
